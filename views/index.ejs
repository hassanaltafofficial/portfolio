<script>
/* ── Particle canvas ── */
(function(){
  const c=document.getElementById('bg-canvas'),ctx=c.getContext('2d');
  let W,H,nodes=[];
  const N=55,D=150;
  function resize(){W=c.width=innerWidth;H=c.height=innerHeight;}
  function init(){nodes=[];for(let i=0;i<N;i++)nodes.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:Math.random()*1.5+.5});}
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(let i=0;i<nodes.length;i++)for(let j=i+1;j<nodes.length;j++){
      const dx=nodes[i].x-nodes[j].x,dy=nodes[i].y-nodes[j].y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<D){ctx.beginPath();ctx.strokeStyle=`rgba(0,229,255,${(1-d/D)*.15})`;ctx.lineWidth=.5;ctx.moveTo(nodes[i].x,nodes[i].y);ctx.lineTo(nodes[j].x,nodes[j].y);ctx.stroke();}
    }
    nodes.forEach(n=>{ctx.beginPath();ctx.arc(n.x,n.y,n.r,0,Math.PI*2);ctx.fillStyle='rgba(0,180,216,.5)';ctx.fill();});
  }
  function update(){nodes.forEach(n=>{n.x+=n.vx;n.y+=n.vy;if(n.x<0||n.x>W)n.vx*=-1;if(n.y<0||n.y>H)n.vy*=-1;});}
  function loop(){update();draw();requestAnimationFrame(loop);}
  window.addEventListener('resize',()=>{resize();init();});
  resize();init();loop();
})();

/* ── Cursor ── */
const cur=document.getElementById('cursor'),curR=document.getElementById('cursor-ring');
document.addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px';curR.style.left=e.clientX+'px';curR.style.top=e.clientY+'px';});
document.querySelectorAll('a,button').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.style.transform='translate(-50%,-50%) scale(2)');
  el.addEventListener('mouseleave',()=>cur.style.transform='translate(-50%,-50%) scale(1)');
});

/* ── Navbar scroll ── */
window.addEventListener('scroll',()=>document.getElementById('navbar').classList.toggle('scrolled',scrollY>40));

/* ── Mobile menu ── */
const hamBtn=document.getElementById('ham-btn'),mob=document.getElementById('mob-menu');
hamBtn.addEventListener('click',()=>{hamBtn.classList.toggle('ham-open');mob.classList.toggle('hidden');});
mob.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{hamBtn.classList.remove('ham-open');mob.classList.add('hidden');}));

/* ── Reveal on scroll ── */
const revObs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show');}),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>revObs.observe(el));

/* ── Progress bars ── */
const barObs=new IntersectionObserver(es=>es.forEach(e=>{
  if(e.isIntersecting)e.target.querySelectorAll('.bar-fill').forEach(b=>setTimeout(()=>b.style.width=b.dataset.width+'%',200));
}),{threshold:.3});
document.querySelectorAll('.card,.card-flat').forEach(c=>barObs.observe(c));

/* ── Counters ── */
function animCounter(el){
  const tgt=+el.dataset.target,suf=el.dataset.suffix||'',dur=1600,step=tgt/(dur/16);
  let v=0;const t=setInterval(()=>{v=Math.min(v+step,tgt);el.textContent=Math.floor(v)+suf;if(v>=tgt)clearInterval(t);},16);
}
const ctrObs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){animCounter(e.target);ctrObs.unobserve(e.target);}}),{threshold:.5});
document.querySelectorAll('.counter').forEach(el=>ctrObs.observe(el));

/* ── Smooth scroll ── */
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const t=document.querySelector(a.getAttribute('href'));if(t)t.scrollIntoView({behavior:'smooth',block:'start'});}));

/* ── Contact form ── */
// Contact form — PURANA code hatao, YEH lagao
document.getElementById('contact-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = this.querySelector('button[type=submit]');
    btn.textContent = 'Sending…';
    btn.disabled = true;
    
    // Form data collect karo
    const formData = {
        name:    this.querySelector('input[type=text]').value,
        email:   this.querySelector('input[type=email]').value,
        subject: this.querySelectorAll('input[type=text]')[1].value,
        message: this.querySelector('textarea').value
    };
    
    try {
        const response = await fetch('/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            this.reset();
            btn.textContent = 'Send Message';
            btn.disabled = false;
            const ok = document.getElementById('form-ok');
            ok.classList.remove('hidden');
            setTimeout(() => ok.classList.add('hidden'), 4000);
        }
    } catch (error) {
        console.error('Error:', error);
        btn.textContent = 'Send Message';
        btn.disabled = false;
    }
});

</script>
</body>
</html>
