    .nav-link{position:relative;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#4a6fa5;transition:color .2s;font-family:'DM Mono',monospace}
    .nav-link::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:#00e5ff;transition:width .3s}
    .nav-link:hover{color:#00e5ff}
    .nav-link:hover::after{width:100%}

    /* Text */
    .grad{background:linear-gradient(135deg,#00e5ff 0%,#00b4d8 60%,#0077b6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .text-glow{text-shadow:0 0 30px rgba(0,229,255,.4)}
    .glow-btn{box-shadow:0 0 20px rgba(0,229,255,.3)}

    /* Animations */
    @keyframes typing{from{width:0}to{width:100%}}
    @keyframes blink{0%,100%{border-color:transparent}50%{border-color:#00e5ff}}
    @keyframes scan{0%{transform:translateY(-100%)}100%{transform:translateY(900%)}}
    @keyframes pulse2{0%,100%{opacity:1}50%{opacity:.4}}

    .type-wrap{display:inline-block;overflow:hidden;border-right:2px solid #00e5ff;white-space:nowrap;animation:typing 3s steps(30,end) .5s both,blink 1s step-end infinite}

    /* Reveal */
    .reveal{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease}
    .reveal.show{opacity:1;transform:translateY(0)}

    /* Cards */
    .card{background:#0f1f35;border:1px solid #1a3050;border-radius:1rem;transition:border-color .3s,transform .3s,box-shadow .3s}
    .card:hover{border-color:#00e5ff44;transform:translateY(-4px);box-shadow:0 8px 48px rgba(0,229,255,.07)}
    .card-flat{background:#0f1f35;border:1px solid #1a3050;border-radius:1rem}

    /* Tags */
    .stag{font-size:.7rem;font-family:'DM Mono',monospace;padding:.25rem .6rem;background:#0b1628;border:1px solid #1a3050;border-radius:.25rem;color:#4a6fa5;transition:all .2s;cursor:default}
    .stag:hover{background:#00e5ff;color:#050c18;border-color:#00e5ff}

    /* Bars */
    .bar-fill{height:3px;background:linear-gradient(90deg,#00e5ff,#0077b6);border-radius:2px;width:0;transition:width 1.2s cubic-bezier(.4,0,.2,1)}

    /* Scan line */
    .scan-wrap{position:relative;overflow:hidden}
    .scan-line{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#00e5ff66,transparent);animation:scan 3s linear infinite}

    /* Stat */
    .stat-val{font-family:'Syne',sans-serif;font-weight:800;font-size:2.4rem;color:#00e5ff;line-height:1}

    /* Project visual */
    .proj-visual{min-height:250px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
    .proj-grid{position:absolute;inset:0;background-image:linear-gradient(#1a3050 1px,transparent 1px),linear-gradient(90deg,#1a3050 1px,transparent 1px);background-size:32px 32px;opacity:.35}

    /* Timeline */
    .tl-line{position:absolute;left:16px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,#00e5ff44,transparent)}
    .tl-dot{position:absolute;left:10px;top:6px;width:13px;height:13px;border-radius:50%;border:2px solid #00e5ff;background:#050c18}

    /* Cert */
    .cert-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;background:#0b1628;border:1px solid #1a3050;border-radius:.5rem;font-size:.73rem;font-family:'DM Mono',monospace;color:#7a9cc8;transition:border-color .2s,color .2s}
    .cert-badge:hover{border-color:#00e5ff44;color:#d4e8ff}

    /* Input */
    .inp{width:100%;background:#0b1628;border:1px solid #1a3050;border-radius:.6rem;color:#d4e8ff;padding:.75rem 1rem;font-family:'DM Sans',sans-serif;font-size:.875rem;transition:border-color .2s,box-shadow .2s;outline:none}
    .inp:focus{border-color:#00e5ff;box-shadow:0 0 0 3px rgba(0,229,255,.08)}
    .inp::placeholder{color:#2a4a70}

    .sec-label{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:#00e5ff;margin-bottom:.4rem}

    /* Hamburger */
    .ham-line{display:block;width:22px;height:2px;background:#d4e8ff;border-radius:2px;transition:all .3s}
    .ham-open .ham-line:nth-child(1){transform:translateY(8px) rotate(45deg)}
    .ham-open .ham-line:nth-child(2){opacity:0}
    .ham-open .ham-line:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

    /* Cursor */
    #cursor{position:fixed;width:8px;height:8px;background:#00e5ff;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform .1s;mix-blend-mode:screen}
    #cursor-ring{position:fixed;width:32px;height:32px;border:1px solid #00e5ff44;border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:left .12s ease,top .12s ease}

    ::-webkit-scrollbar{width:4px}
    ::-webkit-scrollbar-track{background:#050c18}
    ::-webkit-scrollbar-thumb{background:#1a3050;border-radius:2px}

    @media(max-width:768px){
      #cursor,#cursor-ring{display:none}
      .type-wrap{animation:none;border-right:none;width:auto;overflow:visible;white-space:normal}
    }
  </style>
</head>
